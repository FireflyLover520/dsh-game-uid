{
  "name": "dsh-game-uid",
  "version": "0.2.7",
  "description": "UID 练度查询：只展示数据、不打分；支持点名；完整面板（含击破/能量/伤害加成）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./lib/index.js": "./lib/index.js",
    "./package.json": "./package.json",
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "genshin",
    "hsr",
    "uid"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}