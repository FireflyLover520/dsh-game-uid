{
  "name": "dsh-game-uid",
  "version": "0.2.1",
  "description": "DSH 插件：按 UID 查原神 / 星铁 / 绝区零的角色练度与汇总面板（只展示数据，不打分；支持点名只看某个角色）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./lib/index.js": "./lib/index.js",
    "./package.json": "./package.json",
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "genshin",
    "hsr",
    "uid"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
